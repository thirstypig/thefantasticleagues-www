---
interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description = "Fantasy baseball league management powered by AI. Draft grades, trade analysis, weekly insights — all tailored to your league.",
  image,
  ogType = "website",
} = Astro.props;
const APP_URL = "https://app.thefantasticleagues.com";
const SITE_NAME = "The Fantastic Leagues";
const fullTitle = `${title} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const ogImage = image ? new URL(image, Astro.site ?? Astro.url.origin).toString() : null;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Score Sheet — Inter only -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Google Analytics 4 (marketing site) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5FS3SKCH55"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5FS3SKCH55');
    </script>

    <!--
      Score Sheet design tokens — mirrors the FBST app's aurora.css dark mode values.
      Flat paper aesthetic: no gradients, no blur, no glassmorphism.
    -->
    <style is:global>
      :root {
        --am-display: "Inter", system-ui, sans-serif;
        --am-body:    "Inter", system-ui, sans-serif;

        /* Backgrounds */
        --am-bg:             #3d434b;
        --am-surface:        #222630;
        --am-surface-alt:    #292d35;
        --am-surface-strong: #292d35;
        --am-surface-faint:  #222630;

        /* Borders */
        --am-border:        #4a5058;
        --am-border-strong: #6a7079;

        /* Text */
        --am-text:       #f1f2ec;
        --am-text-muted: #d0d2c8;
        --am-text-faint: #c0c5cb;

        /* Accent — outfield green */
        --am-accent:   #82c896;
        --am-accent-2: #8ec1e6;
        --am-cardinal: #8ec1e6;

        /* Status */
        --am-positive: #92d292;
        --am-negative: #e89a9a;

        /* Chips */
        --am-chip:        #303640;
        --am-chip-strong: #3b4047;

        /* Gradient stubs — Score Sheet is flat; nothing should render these */
        --am-glow-1: none;
        --am-glow-2: none;
        --am-glow-3: none;
        --am-irid:   #82c896;
        --am-ring:   none;
      }

      body {
        font-family: var(--am-body);
        background: var(--am-bg);
        color: var(--am-text);
      }

      /* Flat card — replaces am-glass */
      .am-card {
        background: var(--am-surface);
        border: 1px solid var(--am-border);
        border-radius: 12px;
      }

      /* Primary CTA button */
      .am-btn-primary {
        display: inline-block;
        background: var(--am-accent);
        color: #1c1f1a;
        font-weight: 600;
        border-radius: 8px;
        transition: background 0.15s;
      }
      .am-btn-primary:hover {
        background: #6db584;
      }

      /* Ghost button */
      .am-btn-ghost {
        display: inline-block;
        background: var(--am-surface);
        color: var(--am-text-muted);
        border: 1px solid var(--am-border);
        font-weight: 500;
        border-radius: 8px;
        transition: border-color 0.15s, color 0.15s;
      }
      .am-btn-ghost:hover {
        border-color: var(--am-border-strong);
        color: var(--am-text);
      }

      /* Legacy aliases — keep so any stray am-glass / am-irid-* references degrade gracefully */
      .am-glass       { background: var(--am-surface); border: 1px solid var(--am-border); border-radius: 12px; }
      .am-glass-strong{ background: var(--am-surface-strong); border: 1px solid var(--am-border-strong); border-radius: 12px; }
      .am-irid-text   { color: var(--am-accent); }
      .am-irid-bg     { background: var(--am-accent); color: #1c1f1a; }
      .am-display     { font-family: var(--am-display); }
    </style>
  </head>
  <body>
    <!-- Nav — Score Sheet flat strip -->
    <nav class="fixed top-0 w-full z-50" style="background: var(--am-surface); border-bottom: 1px solid var(--am-border);">
      <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 text-base font-semibold" style="color: var(--am-text);">
          <!-- Score Sheet logo mark: flat green square -->
          <span class="inline-flex items-center justify-center text-sm" style="width: 26px; height: 26px; border-radius: 6px; background: var(--am-accent); color: #1c1f1a; font-weight: 800; line-height: 1;">⚾</span>
          <span>The Fantastic Leagues</span>
        </a>
        <div class="hidden md:flex items-center gap-7 text-sm font-medium" style="color: var(--am-text-muted);">
          <a href="/#formats" class="transition-colors hover:text-[var(--am-text)]">Formats</a>
          <a href="/#features" class="transition-colors hover:text-[var(--am-text)]">Features</a>
          <a href="/#pricing" class="transition-colors hover:text-[var(--am-text)]">Pricing</a>
          <a href="/blog" class="transition-colors hover:text-[var(--am-text)]">Blog</a>
        </div>
        <div class="flex items-center gap-3">
          <a href={`${APP_URL}/login`} class="text-sm transition-colors" style="color: var(--am-text-muted);" onmouseover="this.style.color='var(--am-text)'" onmouseout="this.style.color='var(--am-text-muted)'">Sign In</a>
          <a href={`${APP_URL}/signup`} class="am-btn-primary text-sm px-4 py-1.5">Start Free</a>
        </div>
      </div>
    </nav>

    <main class="pt-14">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-24" style="border-top: 1px solid var(--am-border);">
      <div class="max-w-6xl mx-auto px-4 py-12 grid grid-cols-2 md:grid-cols-4 gap-8 text-sm">
        <div>
          <h4 class="font-semibold mb-3" style="color: var(--am-text);">Product</h4>
          <ul class="space-y-2" style="color: var(--am-text-muted);">
            <li><a href="/#features" class="hover:text-[var(--am-text)] transition-colors">Features</a></li>
            <li><a href="/#pricing" class="hover:text-[var(--am-text)] transition-colors">Pricing</a></li>
            <li><a href="/#formats" class="hover:text-[var(--am-text)] transition-colors">Formats</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold mb-3" style="color: var(--am-text);">Resources</h4>
          <ul class="space-y-2" style="color: var(--am-text-muted);">
            <li><a href="/blog" class="hover:text-[var(--am-text)] transition-colors">Blog</a></li>
            <li><a href="/status" class="hover:text-[var(--am-text)] transition-colors">Status</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold mb-3" style="color: var(--am-text);">Company</h4>
          <ul class="space-y-2" style="color: var(--am-text-muted);">
            <li><a href="/about" class="hover:text-[var(--am-text)] transition-colors">About</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold mb-3" style="color: var(--am-text);">App</h4>
          <ul class="space-y-2" style="color: var(--am-text-muted);">
            <li><a href={`${APP_URL}/login`} class="hover:text-[var(--am-text)] transition-colors">Sign In</a></li>
            <li><a href={`${APP_URL}/signup`} class="hover:text-[var(--am-text)] transition-colors">Create Account</a></li>
          </ul>
        </div>
      </div>
      <div class="text-center text-xs pb-8" style="color: var(--am-text-faint);">
        &copy; {new Date().getFullYear()} The Fantastic Leagues. All rights reserved.
      </div>
    </footer>
  </body>
</html>
