---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const now = new Date();
const posts = (await getCollection('blog'))
  .filter((post) => new Date(post.data.date) <= now)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---

<Base title="Blog">
  <section class="max-w-3xl mx-auto px-4 py-20">
    <h1 class="text-4xl font-bold mb-3" style="color: var(--am-text);">Blog</h1>
    <p class="mb-10 text-sm" style="color: var(--am-text-muted);">Fantasy baseball tips, draft strategy, and league management insights.</p>

    {posts.length === 0 ? (
      <div class="am-card p-8 text-center">
        <p style="color: var(--am-text-muted);">Coming soon. First posts launching with the 2026 season.</p>
      </div>
    ) : (
      <div class="space-y-4">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="am-card block p-6 transition-colors group" style="text-decoration: none;" onmouseover="this.style.borderColor='var(--am-accent)'" onmouseout="this.style.borderColor='var(--am-border)'">
            <div class="flex items-center gap-3 mb-3 flex-wrap">
              <time class="text-xs" style="color: var(--am-text-faint);">{new Date(post.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
              {post.data.tags?.map((tag: string) => (
                <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded-full" style="color: var(--am-accent); background: var(--am-chip); border: 1px solid var(--am-border);">{tag}</span>
              ))}
            </div>
            <h2 class="text-xl font-bold mb-2 transition-colors" style="color: var(--am-text);">{post.data.title}</h2>
            <p class="text-sm line-clamp-2" style="color: var(--am-text-muted);">{post.data.description}</p>
          </a>
        ))}
      </div>
    )}
  </section>
</Base>
