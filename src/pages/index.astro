---
import Base from '../layouts/Base.astro';
const APP_URL = "https://app.thefantasticleagues.com";

const scoringFormats = [
  { name: "Rotisserie", desc: "Season-long cumulative stats across 10 categories. The classic format.", available: true },
  { name: "H2H Categories", desc: "Weekly matchups — win more stat categories than your opponent each week.", available: true },
  { name: "H2H Points", desc: "Weekly matchups — highest total points wins. Simple and exciting.", available: true },
];

const features = [
  { icon: "⚖️", title: "Auction Engine", desc: "Real-time bidding with spending pace, value overlays, and AI bid advice. The most feature-rich auction draft on any platform." },
  { icon: "🧠", title: "AI Insights", desc: "8 AI features powered by Google Gemini & Anthropic Claude. Draft grades, trade analysis, weekly insights — all context-aware to YOUR league." },
  { icon: "🛡️", title: "Commissioner Tools", desc: "Franchise management, season lifecycle, roster import, financial tracking, audit logs. Everything a commissioner needs." },
  { icon: "📦", title: "League History", desc: "Import 20 years of history from Excel. All-time records, past drafts, historical standings. Your league's story, preserved." },
  { icon: "📱", title: "Mobile-Ready", desc: "Bottom tab nav, responsive tables, touch-optimized controls. Manage your team from anywhere." },
  { icon: "✨", title: "League Digest", desc: "AI-generated weekly recap with team grades, hot/cold teams, and Trade of the Week poll. The league newsletter writes itself." },
];

const pricingTiers = [
  {
    name: "Free",
    price: "$0",
    period: "forever",
    desc: "Everything you need to run a league",
    features: ["Auction & snake drafts", "Roto & H2H scoring", "10 teams per league", "Real-time MLB stats", "Commissioner tools"],
    cta: "Create Your League",
    highlight: false,
  },
  {
    name: "Pro",
    price: "$29",
    period: "/season",
    desc: "AI-powered league management",
    features: ["All Free features", "AI Insights (8 features)", "FanGraphs projections", "Statcast stats", "Priority notifications", "Unlimited leagues"],
    cta: "Coming Soon",
    highlight: true,
    badge: "Most Popular",
  },
  {
    name: "Commissioner",
    price: "$49",
    period: "/season per league",
    desc: "For serious commissioners",
    features: ["All Pro features", "League health dashboard", "Custom scoring rules", "Archive import (20+ years)", "Announcement system", "Dedicated support"],
    cta: "Coming Soon",
    highlight: false,
  },
];
---

<Base title="Fantasy Baseball, Powered by AI">

  <!-- Hero -->
  <section class="px-4 pt-20 pb-24 text-center">
    <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest mb-8 px-3 py-1.5 rounded-full" style="background: var(--am-chip); color: var(--am-accent); border: 1px solid var(--am-border);">
      ⚾ 2026 Season Live
    </div>
    <h1 class="text-5xl md:text-7xl font-bold leading-tight mb-6" style="letter-spacing: -0.03em; color: var(--am-text);">
      Fantasy Baseball,<br />
      <span style="color: var(--am-accent);">Powered by AI</span>
    </h1>
    <p class="text-lg max-w-xl mx-auto mb-10" style="color: var(--am-text-muted); line-height: 1.7;">
      The only fantasy platform with league-context AI. Draft grades, trade analysis, weekly insights — all tailored to your league.
    </p>
    <div class="flex items-center justify-center gap-4 flex-wrap">
      <a href={`${APP_URL}/signup`} class="am-btn-primary px-8 py-3 text-base">
        Create Your League
      </a>
      <a href="#features" class="am-btn-ghost px-6 py-3 text-base">
        See Features →
      </a>
    </div>
    <p class="text-xs mt-4" style="color: var(--am-text-faint);">No credit card required</p>
  </section>

  <!-- Divider -->
  <div class="max-w-5xl mx-auto px-4" style="border-top: 1px solid var(--am-border);"></div>

  <!-- Formats -->
  <section id="formats" class="max-w-5xl mx-auto px-4 py-16">
    <h2 class="text-2xl font-bold text-center mb-2" style="color: var(--am-text);">Choose Your Format</h2>
    <p class="text-center mb-10 text-sm" style="color: var(--am-text-muted);">Play the way your league likes. More formats coming soon.</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {scoringFormats.map((f) => (
        <div class="am-card p-6">
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-semibold text-base" style="color: var(--am-text);">{f.name}</h3>
            {f.available && (
              <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded-full" style="color: var(--am-accent); background: var(--am-chip); border: 1px solid var(--am-border);">
                Available
              </span>
            )}
          </div>
          <p class="text-sm" style="color: var(--am-text-muted);">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-5xl mx-auto px-4" style="border-top: 1px solid var(--am-border);"></div>

  <!-- Features -->
  <section id="features" class="max-w-5xl mx-auto px-4 py-16">
    <h2 class="text-2xl font-bold text-center mb-2" style="color: var(--am-text);">Built for Serious Leagues</h2>
    <p class="text-center mb-10 text-sm" style="color: var(--am-text-muted);">Every feature a keeper-league commissioner actually needs.</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {features.map((f) => (
        <div class="am-card p-6">
          <div class="text-2xl mb-3">{f.icon}</div>
          <h3 class="font-semibold mb-2" style="color: var(--am-text);">{f.title}</h3>
          <p class="text-sm" style="color: var(--am-text-muted);">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-5xl mx-auto px-4" style="border-top: 1px solid var(--am-border);"></div>

  <!-- Pricing -->
  <section id="pricing" class="max-w-5xl mx-auto px-4 py-16">
    <h2 class="text-2xl font-bold text-center mb-2" style="color: var(--am-text);">Simple Pricing</h2>
    <p class="text-center mb-10 text-sm" style="color: var(--am-text-muted);">Start free. Upgrade when you need more.</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {pricingTiers.map((t) => (
        <div class="am-card p-6 flex flex-col" style={t.highlight ? "border-color: var(--am-accent);" : ""}>
          {t.badge && (
            <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded-full mb-3 self-start" style="color: var(--am-accent); background: var(--am-chip); border: 1px solid var(--am-border);">
              {t.badge}
            </span>
          )}
          <h3 class="text-lg font-bold" style="color: var(--am-text);">{t.name}</h3>
          <div class="mt-2 mb-4">
            <span class="text-4xl font-extrabold" style="color: var(--am-text);">{t.price}</span>
            <span class="text-sm ml-1" style="color: var(--am-text-muted);">{t.period}</span>
          </div>
          <p class="text-sm mb-6" style="color: var(--am-text-muted);">{t.desc}</p>
          <ul class="space-y-2 mb-6 flex-1">
            {t.features.map((feat) => (
              <li class="text-sm flex items-center gap-2" style="color: var(--am-text-muted);">
                <span style="color: var(--am-accent);">✓</span> {feat}
              </li>
            ))}
          </ul>
          <a
            href={t.cta === "Coming Soon" ? "#" : `${APP_URL}/signup`}
            class={t.cta === "Coming Soon" ? "block text-center py-2.5 rounded-lg text-sm font-semibold" : "am-btn-primary block text-center py-2.5 text-sm"}
            style={t.cta === "Coming Soon" ? "background: var(--am-chip); color: var(--am-text-faint); cursor: not-allowed;" : ""}
          >
            {t.cta}
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-5xl mx-auto px-4" style="border-top: 1px solid var(--am-border);"></div>

  <!-- Email Signup -->
  <section class="max-w-2xl mx-auto px-4 py-16 text-center">
    <h2 class="text-2xl font-bold mb-3" style="color: var(--am-text);">Stay in the Loop</h2>
    <p class="mb-8 text-sm" style="color: var(--am-text-muted);">Get notified when Pro and Commissioner tiers launch, plus early access to new features.</p>
    <form action="https://app.thefantasticleagues.com/api/auth/subscribe" method="POST" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
      <input
        type="email"
        name="email"
        placeholder="you@example.com"
        required
        class="flex-1 px-4 py-2.5 rounded-lg text-sm focus:outline-none"
        style="background: var(--am-surface); border: 1px solid var(--am-border); color: var(--am-text);"
        onfocus="this.style.borderColor='var(--am-accent)'"
        onblur="this.style.borderColor='var(--am-border)'"
      />
      <button type="submit" class="am-btn-primary px-6 py-2.5 text-sm whitespace-nowrap">
        Notify Me
      </button>
    </form>
    <p class="text-xs mt-3" style="color: var(--am-text-faint);">No spam. Unsubscribe anytime.</p>
  </section>

  <!-- Final CTA -->
  <section class="text-center py-20 px-4">
    <h2 class="text-3xl font-bold mb-4" style="color: var(--am-text);">Ready to Draft?</h2>
    <p class="mb-8 max-w-md mx-auto text-sm" style="color: var(--am-text-muted);">The 2026 season is free for all features. Set up your league in minutes.</p>
    <a href={`${APP_URL}/signup`} class="am-btn-primary px-8 py-3 text-base">
      Create Your League
    </a>
  </section>

</Base>
