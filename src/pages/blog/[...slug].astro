---
import Base from '../../layouts/Base.astro';
import AdUnit from '../../components/AdUnit.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const now = new Date();
  const posts = (await getCollection('blog')).filter(
    (post) => new Date(post.data.date) <= now
  );
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await post.render();
const APP_URL = "https://app.thefantasticleagues.com";

const words = post.body.split(/\s+/).length;
const readingTime = Math.max(1, Math.round(words / 200));
---

<Base title={post.data.title} description={post.data.description}>
  <article class="max-w-[720px] mx-auto px-5 md:px-0 py-20">
    <a href="/blog" class="text-sm transition-colors mb-8 inline-block" style="color: var(--am-text-muted);" onmouseover="this.style.color='var(--am-text)'" onmouseout="this.style.color='var(--am-text-muted)'">&larr; Back to Blog</a>

    <!-- Header -->
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-5 flex-wrap text-sm" style="color: var(--am-text-faint);">
        <time>{new Date(post.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
        <span style="color: var(--am-border-strong);">·</span>
        <span>{readingTime} min read</span>
        {post.data.tags?.map((tag: string) => (
          <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded-full" style="color: var(--am-accent); background: var(--am-chip); border: 1px solid var(--am-border);">{tag}</span>
        ))}
      </div>
      <h1 class="text-4xl md:text-[44px] font-bold leading-[1.15] tracking-tight mb-5" style="color: var(--am-text);">{post.data.title}</h1>
      <p class="text-lg leading-relaxed" style="color: var(--am-text-muted);">{post.data.description}</p>
      <div class="mt-6 flex items-center gap-3">
        <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm" style="background: var(--am-chip); border: 1px solid var(--am-border);">⚾</div>
        <div>
          <div class="text-sm font-medium" style="color: var(--am-text-muted);">{post.data.author}</div>
          <div class="text-xs italic" style="color: var(--am-text-faint);">Written with AI</div>
        </div>
      </div>
    </header>

    <!-- Hero image -->
    {post.data.heroImage && (
      <figure class="mb-14">
        <img
          src={post.data.heroImage}
          alt={post.data.heroAlt || post.data.title}
          class="w-full rounded-xl object-cover max-h-[400px]"
          style="border: 1px solid var(--am-border);"
          loading="eager"
        />
        {post.data.heroCredit && (
          <figcaption class="text-xs mt-3 text-center" style="color: var(--am-text-faint);">{post.data.heroCredit}</figcaption>
        )}
      </figure>
    )}

    <!-- Article body -->
    <div class="blog-content">
      <Content />
    </div>

    <!-- Ad unit 2 — after article body, before CTA -->
    <div class="mt-12 mb-4">
      <AdUnit slot="5685126423" format="auto" />
    </div>

    <!-- End CTA -->
    <div class="am-card mt-20 py-10 px-8 text-center">
      <h3 class="text-xl font-bold mb-2" style="color: var(--am-text);">Ready to try it?</h3>
      <p class="text-sm mb-6" style="color: var(--am-text-muted);">Create your league in minutes. Free to use — no credit card required.</p>
      <a href={`${APP_URL}/signup`} class="am-btn-primary inline-block px-8 py-3 text-sm">
        Create Your League
      </a>
    </div>
  </article>
</Base>

<style is:global>
  /* ── Blog Typography — Score Sheet palette ── */

  .blog-content {
    font-size: 18px;
    line-height: 1.75;
    color: var(--am-text-muted);
    letter-spacing: 0.005em;
  }

  .blog-content p {
    margin-bottom: 1.75rem;
  }

  .blog-content h2 {
    font-size: 1.625rem;
    font-weight: 700;
    color: var(--am-text);
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--am-border);
  }

  .blog-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--am-text);
    line-height: 1.4;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .blog-content a {
    color: var(--am-accent);
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .blog-content a:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  .blog-content strong {
    color: var(--am-text);
    font-weight: 600;
  }
  .blog-content em {
    color: var(--am-text-faint);
  }

  .blog-content blockquote {
    border-left: 3px solid var(--am-accent);
    background: var(--am-surface-alt);
    border-radius: 0 8px 8px 0;
    padding: 1.25rem 1.5rem;
    margin: 2.5rem 0;
    font-size: 1.05rem;
    color: var(--am-text);
    font-style: normal;
  }
  .blog-content blockquote p {
    margin-bottom: 0;
  }

  .blog-content ul,
  .blog-content ol {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
  }
  .blog-content li {
    margin-bottom: 0.5rem;
    color: var(--am-text-muted);
  }
  .blog-content ul li::marker {
    color: var(--am-accent);
  }

  .blog-content hr {
    border: none;
    border-top: 1px solid var(--am-border);
    margin: 3rem 0;
  }

  .blog-content img {
    border-radius: 8px;
    border: 1px solid var(--am-border);
    margin: 2rem 0;
  }

  .blog-content code {
    background: var(--am-surface-alt);
    border: 1px solid var(--am-border);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 0.9em;
    color: var(--am-text);
  }
</style>
